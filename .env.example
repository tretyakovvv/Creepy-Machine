PORT=3000
SITE_URL=https://example.com
SESSION_SECRET=change-this-to-a-long-random-string
DATABASE_PATH=./data/creepy-machine.db

# AES-256-GCM encryption for DB (emails, prompts, API keys in settings)
# Generate: openssl rand -hex 32
DB_ENCRYPTION_KEY=

# OpenRouter (also configurable in Admin → AI Providers in database)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_AUTO_FREE_MODELS=true
OPENROUTER_FREE_MODEL_LIMIT=40
# Optional: auto-fill OpenRouter provider key on first server start

# DeepSeek direct API (optional; also configurable in Admin → AI Providers)
# Base URL used by default: https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Temporary one-click Google-like auth for testing. Disable before production.
TEMP_GOOGLE_AUTH_ENABLED=false

# Legacy dev login endpoint (/api/auth/dev). Keep disabled on hosting/production.
DEV_AUTH_ENABLED=false

# Admin (server-side login for admin API)
ADMIN_PASSWORD=creepy2024

# YooKassa
# Add https://example.com/api/payments/yookassa/webhook in YooKassa webhooks.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
